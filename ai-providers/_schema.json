{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "description", "instructions", "keyUrl"],
  "additionalProperties": false,
  "properties": {
    "id":          { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name":        { "$ref": "#/$defs/i18nString" },
    "description": { "$ref": "#/$defs/i18nString" },
    "instructions": {
      "type": "object",
      "required": ["vi", "en"],
      "additionalProperties": false,
      "properties": {
        "vi": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "en": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "videoUrl": { "type": "string", "format": "uri" },
    "keyUrl":   { "type": "string", "format": "uri" }
  },
  "$defs": {
    "i18nString": {
      "type": "object",
      "required": ["vi", "en"],
      "additionalProperties": false,
      "properties": {
        "vi": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
